# ============================================================
# Delphi Nox Dark — .env TEMPLATE  (copy to ".env", fill in, NEVER commit)
# ------------------------------------------------------------
# PAPER MODE NEEDS NONE OF THESE KEYS. The engine simulates fills on REAL
# live venue prices with real fee/borrow math. Add keys ONLY when you are
# ready to graduate paper -> testnet -> live (live requires an explicit "Go").
#
# This file is a separate, self-contained .env for the Nox Dark build. It must
# NOT contain the same live secrets as the main Delphi Nova .env — generate
# distinct API keys per build/venue so the two run fully isolated.
# ============================================================

# ---- Engine mode -----------------------------------------------------------
# paper (default) | testnet | live   — paper/testnet sign nothing real.
DELPHI_MODE=paper

# ---- Nox Dark identity (the launcher already sets these; override if desired)
DELPHI_NAME=Delphi Nox Dark
DELPHI_PROFILE=nox_dark
DASHBOARD_PORT=8081

# ---- Aster (primary venue) — REST HMAC-SHA256 ------------------------------
# Create at https://www.asterdex.com/en/api-management  (testnet first)
ASTER_API_KEY=
ASTER_API_SECRET=
# Optional URL overrides (defaults target Aster mainnet for DATA; trading
# respects DELPHI_MODE). Leave blank to use built-in defaults.
ASTER_BASE_URL=
ASTER_DATA_URL=
ASTER_TESTNET_URL=

# ---- ApeX Omni (secondary venue) — StarkEx L2 ------------------------------
# Create at https://omni.apex.exchange  ->  keyManagement  (testnet first)
APEX_API_KEY=
APEX_API_SECRET=
APEX_API_PASSPHRASE=
APEX_ZK_SEEDS=
APEX_ZK_L2KEY=
APEX_BASE_URL=
APEX_DATA_URL=
APEX_TESTNET_URL=

# ---- Optional market-data / sentiment keys (engine degrades gracefully) ----
BIRDEYE_API_KEY=
COINGECKO_API_KEY=
FRED_API_KEY=
LUNARCRUSH_API_KEY=
X_BEARER_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ---- Risk overrides (optional; the nox_dark profile already sets these) -----
# DELPHI_LEVERAGE_CAP=40
# DELPHI_FEE_BUDGET=0.20
# STARTING_BALANCE=100.0
